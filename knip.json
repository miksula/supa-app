{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".agents/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.js"]
    },
    "app": {
      "entry": ["src/index.html", "src/css/index.css"],
      "project": ["src/**/*.{ts,css}", "!src/css/theme.css"],
      "ignoreDependencies": ["@journeyapps/wa-sqlite"]
    },
    "packages/*": {}
  }
}
