{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "useDefineForClassFields": false,
    "lib": ["dom", "dom.iterable", "es2022"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/lib/*"],
      "@packages/docs": ["../packages/docs/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
