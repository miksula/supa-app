# Self-hosted Environment Configuration
# Copy this template: `cp .env.local.template .env.local`
# Edit .env.local and enter your Supabase and PowerSync project details.

VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_POWERSYNC_URL=http://localhost:8080

# Local-Only Mode: runs without a backend. Data stays on this device in
# `supa-app-local.db` and never syncs. The login is cosmetic (the credentials
# below are compiled into the JavaScript bundle and are not secret; they do not
# protect the data stored on the device). Required by `npm run build:offline`.
VITE_OFFLINE_MODE=false
VITE_LOCAL_AUTH_EMAIL=dev@example.com
VITE_LOCAL_AUTH_PASSWORD=password123

# Optional login form prefill, used only by the dev server (`import.meta.env.DEV`).
# Matches the user seeded by stack/supabase/seed.sql.
VITE_DEV_EMAIL=dev@example.com
VITE_DEV_PASSWORD=password123

# Optional dev server port override (defaults to Vite's 5173).
VITE_DEV_PORT=5173
