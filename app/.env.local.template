# Self-hosted Environment Configuration
# Copy this template: `cp .env.local.template .env.local`
# Edit .env.local and enter your Supabase and PowerSync project details.

VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_POWERSYNC_URL=http://localhost:8080

# Developer offline mode: disables auth enforcement and sync so you can work on the
# frontend without a running backend. Local DB still works.
VITE_OFFLINE_MODE=false

# Optional login form prefill, used only by the dev server (`import.meta.env.DEV`).
# Matches the user seeded by stack/supabase/seed.sql.
VITE_DEV_EMAIL=dev@example.com
VITE_DEV_PASSWORD=password123
