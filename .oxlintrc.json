{
  "extends": ["./packages/oxlint-plugin/recommended.json"],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_$"
      }
    ],
    "no-console": [
      "warn",
      {
        "allow": ["error", "warn"]
      }
    ]
  },
  "ignorePatterns": ["**/dist/**", ".agents/**"],
  "overrides": [
    {
      "files": ["scripts/**", "packages/styles-cli/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
