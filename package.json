{
  "name": "supa-app",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "schema:generate": "powersync generate schema --output=ts --output-path=app/src/lib/schema.ts --directory=backend/powersync",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "type-check": "bun check -p app/tsconfig.json"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0"
  }
}