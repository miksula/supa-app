# PowerSync service environment. Copy to `.env` (git-ignored) and adjust:
#   cp stack/powersync/docker/.env.template stack/powersync/docker/.env
# The defaults target the local Supabase database (default local credentials).

# external Database Config
# Replication source: powersync_role (created by migrations, local password set in seed.sql)
PS_DATA_SOURCE_URI=postgresql://powersync_role:powersync_local@host.docker.internal:54322/postgres

# external Storage Config
PS_STORAGE_SOURCE_URI=postgresql://postgres:postgres@host.docker.internal:54322/postgres
